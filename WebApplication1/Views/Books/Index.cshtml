@model IEnumerable<Common.Models.Book>

@{
    ViewData["Title"] = "Books Catalogue";
}

<style>
    .catalogue-header {
        background: linear-gradient(120deg, #172554, #334e87);
        border-radius: 20px;
        padding: 32px;
        color: white;
        margin-bottom: 30px;
    }

        .catalogue-header h2 {
            font-weight: 800;
            letter-spacing: -.5px;
        }

    .search-panel {
        background: #fff;
        padding: 20px;
        border-radius: 16px;
        box-shadow: 0 4px 20px rgba(0,0,0,.05);
        margin-bottom: 30px;
    }

    .book-card {
        border: 1px solid #edf0f5;
        border-radius: 18px;
        overflow: hidden;
        background: white;
        transition: transform .2s, box-shadow .2s;
    }

        .book-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 12px 30px rgba(0,0,0,.09);
        }

    .book-cover-area {
        width: 115px;
        min-width: 115px;
        height: 165px;
        border-radius: 10px;
        overflow: hidden;
        background: #f1f4f9;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .book-cover {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .cover-placeholder {
        width: 100%;
        height: 100%;
        background: linear-gradient(145deg, #dbe5f4, #eef2f9);
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        color: #64748b;
        text-align: center;
        padding: 12px;
    }

        .cover-placeholder .book-icon {
            font-size: 40px;
            margin-bottom: 8px;
        }

        .cover-placeholder small {
            font-size: 10px;
            text-transform: uppercase;
            letter-spacing: 1px;
            font-weight: 700;
        }

    .book-title {
        font-size: 1.1rem;
        font-weight: 750;
        color: #172554;
        line-height: 1.35;
        margin-bottom: 6px;
    }

    .book-author {
        font-size: .85rem;
        color: #64748b;
    }

    .book-meta {
        font-size: .8rem;
        color: #64748b;
    }

    .category-badge {
        background: #eef2ff;
        color: #4338ca;
        font-size: .72rem;
        padding: 6px 10px;
        border-radius: 30px;
        font-weight: 600;
    }

    .availability-badge {
        font-size: .72rem;
        padding: 6px 10px;
        border-radius: 30px;
        font-weight: 600;
    }

    .book-actions {
        border-top: 1px solid #f1f3f6;
        padding-top: 14px;
        margin-top: 18px;
    }

        .book-actions .btn {
            border-radius: 8px;
            font-size: .8rem;
            font-weight: 600;
        }

    body {
        background: #f8fafc;
    }
</style>

<div class="container py-4">

    <!-- Header -->
    <div class="catalogue-header d-flex flex-wrap
                justify-content-between align-items-center gap-3">

        <div>
            <h2 class="mb-2">📚 Books Catalogue</h2>
            <p class="mb-0 opacity-75">
                Discover and manage your book collection.
            </p>
        </div>

        <a asp-action="Create"
           class="btn btn-light fw-bold px-4 py-2">
            + Add New Book
        </a>
    </div>

    <!-- Search -->
    <div class="search-panel">
        <form asp-controller="Books"
              asp-action="Search"
              method="get">

            <div class="input-group">
                <input type="text"
                       name="keyword"
                       class="form-control form-control-lg"
                       placeholder="Search by title, author or ISBN..."
                       value="@Context.Request.Query["keyword"]" />

                <button type="submit"
                        class="btn btn-primary px-4">
                    Search
                </button>

                <a asp-controller="Books"
                   asp-action="Index"
                   class="btn btn-outline-secondary
                          d-flex align-items-center">
                    Clear
                </a>
            </div>
        </form>
    </div>

    <!-- Results -->
    <div class="d-flex justify-content-between
                align-items-center mb-3">

        <h5 class="fw-bold mb-0">Explore Books</h5>

        <span class="text-muted small">
            @Model.Count() books found
        </span>
    </div>

    <!-- Cards -->
    <div class="row g-4">

        @foreach (var book in Model)
        {
            <div class="col-12 col-lg-6">

                <div class="book-card h-100 p-3
                                d-flex flex-column">

                    <div class="d-flex gap-3">

                        <!-- Cover Thumbnail -->
                        <div class="book-cover-area">

                            @if (!string.IsNullOrWhiteSpace(book.Cover))
                            {
                                <img src="@book.Cover"
                                     alt="Cover of @book.Title"
                                     class="book-cover"
                                     loading="lazy"
                                     onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" />

                                <div class="cover-placeholder"
                                     style="display:none;">
                                    <div class="book-icon">📖</div>
                                    <small>No Cover</small>
                                </div>
                            }
                            else
                            {
                                <div class="cover-placeholder">
                                    <div class="book-icon">📖</div>
                                    <small>No Cover</small>
                                </div>
                            }

                        </div>

                        <!-- Book Information -->
                        <div class="flex-grow-1"
                             style="min-width:0;">

                            <div class="mb-2">
                                <span class="category-badge">
                                    @(book.Category?.Name ?? "Uncategorised")
                                </span>
                            </div>

                            <h5 class="book-title">
                                @book.Title
                            </h5>

                            <div class="book-author mb-3">
                                By @(book.Author ?? "Unknown Author")
                            </div>

                            <div class="book-meta mb-1">
                                <strong>ISBN:</strong> @book.Isbn
                            </div>

                            <div class="book-meta mb-2">
                                <strong>Published:</strong>
                                @book.PublishedYear
                            </div>

                            @if (book.Available)
                            {
                                <span class="badge bg-success
                                                     availability-badge">
                                    ● Available
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-danger
                                                     availability-badge">
                                    ● Unavailable
                                </span>
                            }

                        </div>
                    </div>

                    <!-- Actions -->
                    <div class="book-actions mt-auto
                                    d-flex gap-2">

                        <a asp-action="Details"
                           asp-route-id="@book.Isbn"
                           class="btn btn-primary flex-fill">
                            Details
                        </a>

                        <a asp-action="Edit"
                           asp-route-id="@book.Isbn"
                           class="btn btn-outline-secondary flex-fill">
                            Edit
                        </a>

                        <a asp-action="Delete"
                           asp-route-id="@book.Isbn"
                           class="btn btn-outline-danger flex-fill">
                            Delete
                        </a>

                    </div>

                </div>
            </div>
        }

    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-5">
            <div style="font-size:55px;">📚</div>
            <h4 class="fw-bold mt-3">No books found</h4>
            <p class="text-muted">
                Try searching for another title or author.
            </p>

            <a asp-action="Index"
               class="btn btn-primary">
                View All Books
            </a>
        </div>
    }

</div>
