@model Common.Models.Book

@{
    ViewData["Title"] = "Edit Book";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">

            <h2 class="mb-4">Edit Book</h2>

            <form action="/Books/Edit"
                  method="post"
                  enctype="multipart/form-data">

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3"></div>

                <!-- ISBN - Cannot be edited -->
                <div class="mb-3">
                    <label class="form-label">ISBN</label>

                    <input asp-for="Isbn"
                           class="form-control bg-light"
                           readonly />

                    <small class="text-muted">
                        ISBN cannot be modified.
                    </small>
                </div>

                <!-- Title -->
                <div class="mb-3">
                    <label asp-for="Title"
                           class="form-label"></label>

                    <input asp-for="Title"
                           class="form-control"
                           placeholder="Enter book title" />

                    <span asp-validation-for="Title"
                          class="text-danger"></span>
                </div>

                <!-- Published Year -->
                <div class="mb-3">
                    <label asp-for="PublishedYear"
                           class="form-label">
                        Published Year
                    </label>

                    <input asp-for="PublishedYear"
                           type="number"
                           class="form-control"
                           min="1450"
                           max="2100" />

                    <span asp-validation-for="PublishedYear"
                          class="text-danger"></span>
                </div>

                <!-- Author -->
                <div class="mb-3">
                    <label asp-for="Author"
                           class="form-label"></label>

                    <input asp-for="Author"
                           class="form-control"
                           placeholder="Enter author name (optional)" />

                    <span asp-validation-for="Author"
                          class="text-danger"></span>
                </div>

                <!-- Category -->
                <div class="mb-3">
                    <label asp-for="CategoryFK"
                           class="form-label">
                        Category
                    </label>

                    <select name="CategoryFK"
                            class="form-control">

                        <option value="">Select Category</option>

                        @foreach (Common.Models.Category c
                                                in ViewBag.Categories)
                        {
                            if (c.Id == Model.CategoryFK)
                            {
                                <option value="@c.Id" selected>
                                    @c.Name
                                </option>
                            }
                            else
                            {
                                <option value="@c.Id">
                                    @c.Name
                                </option>
                            }
                        }
                    </select>

                    <span asp-validation-for="CategoryFK"
                          class="text-danger"></span>
                </div>

                <!-- Available -->
                <div class="form-check mb-4">
                    <input asp-for="Available"
                           class="form-check-input" />

                    <label asp-for="Available"
                           class="form-check-label">
                        Available for borrowing
                    </label>
                </div>

                <!-- Current Cover Photo -->
                <div class="mb-3">
                    <label class="form-label">
                        Current Cover Photo:
                    </label>

                    @if (!string.IsNullOrEmpty(Model.Cover))
                    {
                        <div class="mb-2">
                            <img src="@Model.Cover"
                                 alt="Book Cover"
                                 class="img-thumbnail"
                                 style="max-height:200px;" />
                        </div>
                    }
                    else
                    {
                        <p class="text-muted">
                            No cover photo uploaded.
                        </p>
                    }
                </div>

                <!-- Upload New Cover -->
                <div class="mb-3">
                    <label class="form-label">
                        Change Cover Photo:
                    </label>

                    <input name="file"
                           class="form-control"
                           type="file"
                           accept="image/*" />

                    <small class="text-muted">
                        Leave empty to keep the existing cover photo.
                    </small>
                </div>

                <!-- Buttons -->
                <button type="submit"
                        class="btn btn-primary">
                    Save Changes
                </button>

                <a href="/Books/Index"
                   class="btn btn-secondary">
                    Back to List
                </a>

            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
