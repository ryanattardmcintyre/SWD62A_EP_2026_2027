@model Common.Models.Reservation

@{
    ViewData["Title"] = "Borrow a Book";
}

<div class="container mt-4">

    <div class="row justify-content-center">
        <div class="col-md-6">

            <div class="card shadow-sm border-0 rounded-3">

                <div class="card-header bg-white border-0 pt-4 px-4">
                    <h3 class="fw-bold mb-1">Borrow a Book</h3>
                    <p class="text-muted mb-0">
                        Enter the ISBN of the book you wish to borrow.
                    </p>
                </div>

                <div class="card-body p-4">

                    <form asp-action="SelfBorrow" method="post">

                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3"></div>

                        <div class="mb-4">
                            <label asp-for="BookFK"
                                   class="form-label fw-semibold">
                                Book ISBN
                            </label>

                            <input asp-for="BookFK"
                                   class="form-control form-control-lg"
                                   placeholder="Enter book ISBN"
                                   autofocus
                                   required />

                            <span asp-validation-for="BookFK"
                                  class="text-danger small"></span>
                        </div>

                        <div class="d-flex justify-content-end gap-2">

                            <a asp-action="Index"
                               class="btn btn-outline-secondary">
                                Cancel
                            </a>

                            <button type="submit"
                                    class="btn btn-primary px-4">
                                Borrow Book
                            </button>

                        </div>

                    </form>

                </div>
            </div>

        </div>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
