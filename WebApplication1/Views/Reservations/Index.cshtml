@model IEnumerable<Common.Models.Reservation>

@{
    ViewData["Title"] = "Reservations";
}

<div class="container mt-4">

    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">Book Reservations</h2>
            <p class="text-muted mb-0">
                Manage and track book reservations
            </p>
        </div>

        <a href="/Reservations/SelfBorrow" class="btn btn-primary">
            + New Reservation
        </a>
    </div>

    <!-- Reservations Table -->
    <div class="card shadow-sm border-0 rounded-3">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">

                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">ID</th>
                            <th>Book</th>
                            <th>Username</th>
                            <th>Date Taken</th>
                            <th>Due Date</th>
                            <th>Date Returned</th>
                            <th>Status</th>
                            <th class="text-end pe-4">Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var reservation in Model)
                        {
                            var status = "Active";
                            var badgeClass = "bg-primary";

                            if (reservation.DateReturned.HasValue)
                            {
                                status = "Returned";
                                badgeClass = "bg-success";
                            }
                            else if (reservation.DateDue.Date < DateTime.Today)
                            {
                                status = "Overdue";
                                badgeClass = "bg-danger";
                            }

                            <tr>
                                <td class="ps-4 fw-semibold">
                                    #@reservation.Id
                                </td>

                                <td>
                                    <span class="fw-semibold">
                                        @(reservation.Book?.Title ?? reservation.BookFK)
                                    </span>
                                </td>

                                <td>@reservation.Username</td>

                                <td>
                                    @reservation.DateTaken.ToString("dd MMM yyyy")
                                </td>

                                <td>
                                    @reservation.DateDue.ToString("dd MMM yyyy")
                                </td>

                                <td>
                                    @if (reservation.DateReturned.HasValue)
                                    {
                                        @reservation.DateReturned.Value.ToString("dd MMM yyyy")
                                    }
                                    else
                                    {
                                        <span class="text-muted">Not returned</span>
                                    }
                                </td>

                                <td>
                                    <span class="badge @badgeClass">
                                        @status
                                    </span>
                                </td>

                                <td class="text-end pe-4">
                                    <div class="d-inline-flex gap-1">

                                        <a asp-action="Details"
                                           asp-route-id="@reservation.Id"
                                           class="btn btn-sm btn-outline-secondary">
                                            Details
                                        </a>

                                        <a asp-action="Edit"
                                           asp-route-id="@reservation.Id"
                                           class="btn btn-sm btn-outline-primary">
                                            Edit
                                        </a>

                                        <a asp-action="Delete"
                                           asp-route-id="@reservation.Id"
                                           class="btn btn-sm btn-outline-danger">
                                            Delete
                                        </a>

                                    </div>
                                </td>
                            </tr>
                        }

                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="8"
                                    class="text-center text-muted py-5">
                                    No reservations found.
                                </td>
                            </tr>
                        }
                    </tbody>

                </table>
            </div>
        </div>
    </div>
</div>
